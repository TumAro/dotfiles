# ── Mod key — Super (Windows key) ─────────────────────────────────────────────
set $mod Mod4

# ── Font ──────────────────────────────────────────────────────────────────────
font pango:JetBrainsMonoNL Nerd Font 11

# ── Startup ───────────────────────────────────────────────────────────────────
exec_always --no-startup-id xsetroot -solid '#0a0e14'
exec --no-startup-id udiskie --tray
exec --no-startup-id redshift -O 3500
exec --no-startup-id touchegg
exec_always --no-startup-id ~/.config/polybar/launch.sh

# ── Terminal ──────────────────────────────────────────────────────────────────
set $term ~/.local/kitty.app/bin/kitty
# Plain terminal. Zellij only on purpose: cd into a repo and run `ws`.
bindsym $mod+t exec $term

# ── App launcher (rofi) ───────────────────────────────────────────────────────
bindsym $mod+space exec ~/.config/polybar/forest/scripts/launcher.sh

# ── Network menu (rofi + nmcli) ───────────────────────────────────────────────
bindsym $mod+n exec --no-startup-id ~/.config/polybar/forest/scripts/networkmenu.sh

# ── Window management ─────────────────────────────────────────────────────────
bindsym Mod1+F4      kill
bindsym $mod+F11     fullscreen toggle
bindsym $mod+shift+space floating toggle

# Focus — arrow keys
bindsym $mod+Left  focus left
bindsym $mod+Down  focus down
bindsym $mod+Up    focus up
bindsym $mod+Right focus right

# Move windows — arrow keys
bindsym $mod+shift+Left  move left
bindsym $mod+shift+Down  move down
bindsym $mod+shift+Up    move up
bindsym $mod+shift+Right move right

# ── Splits ────────────────────────────────────────────────────────────────────
bindsym $mod+s split h
bindsym $mod+d split v

# ── Workspaces ────────────────────────────────────────────────────────────────
set $ws1 "1:term"
set $ws2 "2:zen"
set $ws3 "3:notes"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+shift+1 move container to workspace $ws1
bindsym $mod+shift+2 move container to workspace $ws2
bindsym $mod+shift+3 move container to workspace $ws3
bindsym $mod+shift+4 move container to workspace $ws4
bindsym $mod+shift+5 move container to workspace $ws5
bindsym $mod+shift+6 move container to workspace $ws6
bindsym $mod+shift+7 move container to workspace $ws7
bindsym $mod+shift+8 move container to workspace $ws8
bindsym $mod+shift+9 move container to workspace $ws9
bindsym $mod+shift+0 move container to workspace $ws10

# Apps live on their own workspace, and opening one jumps you there
for_window [class="(?i)^zen"] move container to workspace $ws2, workspace $ws2
for_window [class="(?i)^obsidian"] move container to workspace $ws3, workspace $ws3

# Big apps change over time, so no fixed list: open the app on a fresh workspace (Super+4..9),
# then Super+p pins it there (names the workspace after it). Super+p again unpins.
include ~/.config/i3/pinned.conf
bindsym $mod+p exec --no-startup-id ~/.config/i3/scripts/pin.sh

# ── Resize mode ───────────────────────────────────────────────────────────────
mode "resize" {
  bindsym Left  resize shrink width 10 px or 10 ppt
  bindsym Down  resize grow height 10 px or 10 ppt
  bindsym Up    resize shrink height 10 px or 10 ppt
  bindsym Right resize grow width 10 px or 10 ppt
  bindsym Return mode "default"
  bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Mouse resize
floating_modifier $mod

# ── System controls ───────────────────────────────────────────────────────────
bindsym $mod+shift+c reload
bindsym $mod+shift+r restart

# ── Power menu ────────────────────────────────────────────────────────────────
bindsym $mod+Escape exec ~/.config/polybar/forest/scripts/powermenu.sh
bindsym $mod+l exec --no-startup-id i3lock -c 0a0e14 -e -f

# ── Volume ────────────────────────────────────────────────────────────────────
bindsym XF86AudioRaiseVolume exec ~/.config/i3/scripts/volctl.sh up
bindsym XF86AudioLowerVolume exec ~/.config/i3/scripts/volctl.sh down
bindsym XF86AudioMute        exec ~/.config/i3/scripts/volctl.sh mute

# ── Brightness ───────────────────────────────────────────────────────────────
bindsym XF86MonBrightnessUp   exec ~/.config/i3/scripts/brightctl.sh up
bindsym XF86MonBrightnessDown exec ~/.config/i3/scripts/brightctl.sh down

# ── Screenshot ────────────────────────────────────────────────────────────────
bindsym Print             exec maim -s | xclip -selection clipboard -t image/png
bindsym $mod+shift+p      exec maim -s | xclip -selection clipboard -t image/png
bindsym ctrl+Print        exec maim -s ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
bindsym $mod+ctrl+p       exec maim -s ~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png

# ── Yazi file manager ─────────────────────────────────────────────────────────
bindsym $mod+e exec ~/.local/kitty.app/bin/kitty -e yazi

# ── Appearance ────────────────────────────────────────────────────────────────
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart
bindsym $mod+b exec bt-buds

# ── Ayu Dark window colours ───────────────────────────────────────────────────
#                       border   bg       text     indicator child_border
client.focused          #e6b450  #0a0e14  #b3b1ad  #e6b450   #e6b450
client.focused_inactive #1c222c  #0a0e14  #6c7380  #1c222c   #1c222c
client.unfocused        #1c222c  #0a0e14  #4d5566  #1c222c   #1c222c
client.urgent           #ff3333  #0a0e14  #ff3333  #ff3333   #ff3333
client.background       #0a0e14

# ── Browser: focus Zen if running, otherwise launch it ────────────────────────
bindsym $mod+z exec --no-startup-id sh -c '[ "$(i3-msg "[class=\"(?i)^zen\"] focus" | grep -c true)" -gt 0 ] || $HOME/.local/bin/zen'
