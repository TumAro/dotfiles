// built-in zellij theme (zellij.dev/documentation/theme-list); no custom colours
theme "ayu_dark"

// no borders; only the focused pane is marked by dimming the others
pane_frames false
simplified_ui true
default_layout "hints"
show_startup_tips false
show_release_notes false

keybinds {
    // default Ctrl q quits the whole session instantly; use Alt+k (asks first) instead
    unbind "Ctrl q"
    shared_except "locked" {
        bind "Alt m" { Run "tdx" { floating true; close_on_exit true; }; }
        bind "Alt t" { NewTab; }
        bind "Alt q" { Detach; }
        bind "Alt k" { LaunchOrFocusPlugin "zj-quit" { floating true; move_to_focused_tab true; }; }
        bind "Alt x" { CloseFocus; }
        bind "Alt /" { Run "sh" "-c" "bat --paging=always --style=plain --color=never ~/.config/zellij/keys.txt" { floating true; close_on_exit true; }; }
        bind "Alt c" { CloseTab; }
        bind "Alt s" { NewPane "Right"; }
        bind "Alt d" { NewPane "Down"; }
        bind "Alt y" { Run "yazi" { floating true; close_on_exit true; }; }
    }
}

// ── Plugins (local .wasm files in ~/.config/zellij/plugins, fetched by .scripts/deps.sh) ──
// Status line colours: Ayu Dark, palette in ~/dotfiles/theme/ayu-dark.md
plugins {
    zjstatus location="file:~/.config/zellij/plugins/zjstatus.wasm" {
        format_left   "{mode}{tabs}"
        format_center ""
        format_right  "{pipe_zjstatus_hints}#[fg=#e6b450,bold] {session} "
        format_space  "#[bg=#0a0e14]"
        format_hide_on_overlength "true"
        format_precedence "lrc"

        border_enabled "false"
        hide_frame_for_single_pane "true"

        pipe_zjstatus_hints_format "{output}"

        mode_normal      "#[bg=#e6b450,fg=#0a0e14,bold] NORMAL #[bg=#0a0e14,fg=#4d5566,nobold] Alt+/ keys   Alt+s|d split   Alt+x close   Ctrl+p pane "
        mode_locked      "#[bg=#4d5566,fg=#0a0e14,bold] LOCKED "
        mode_pane        "#[bg=#c2d94c,fg=#0a0e14,bold] PANE "
        mode_tab         "#[bg=#59c2ff,fg=#0a0e14,bold] TAB "
        mode_resize      "#[bg=#ff8f40,fg=#0a0e14,bold] RESIZE "
        mode_move        "#[bg=#ff8f40,fg=#0a0e14,bold] MOVE "
        mode_scroll      "#[bg=#d2a6ff,fg=#0a0e14,bold] SCROLL "
        mode_search      "#[bg=#95e6cb,fg=#0a0e14,bold] SEARCH "
        mode_entersearch "#[bg=#95e6cb,fg=#0a0e14,bold] SEARCH "
        mode_renametab   "#[bg=#59c2ff,fg=#0a0e14,bold] RENAME "
        mode_renamepane  "#[bg=#c2d94c,fg=#0a0e14,bold] RENAME "
        mode_session     "#[bg=#ff3333,fg=#0a0e14,bold] SESSION "
        mode_tmux        "#[bg=#d2a6ff,fg=#0a0e14,bold] TMUX "

        tab_normal   "#[bg=#0a0e14,fg=#4d5566] {index} {name} "
        tab_active   "#[bg=#0a0e14,fg=#e6b450,bold] {index} {name} "
        tab_separator ""
    }
    zjstatus-hints location="file:~/.config/zellij/plugins/zjstatus-hints.wasm" {
        max_length 70
        overflow_str "…"
        pipe_name "zjstatus_hints"
        hide_in_base_mode true
    }
    zj-quit location="file:~/.config/zellij/plugins/zj-quit.wasm" {
        confirm_key "y"
        cancel_key "Esc"
    }
}
load_plugins {
    zjstatus-hints
}
